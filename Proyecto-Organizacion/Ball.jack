class Ball {
    field int location;  // Posición de la pelota en memoria

    // Constructor
    constructor Ball new(int initLocation) {
        let location = initLocation;
        return this;
    }

    // Método para dibujar la pelota en la ubicación actual
    method void draw() {
        var int memAddress;
        let memAddress = 16384 + location;

        // Dibujo de la pelota con los valores de intensidad de píxeles
        do Memory.poke(memAddress, 2016);
        do Memory.poke(memAddress + 32, 8184);
        do Memory.poke(memAddress + 64, 16380);
        do Memory.poke(memAddress + 96, 32766);
        do Memory.poke(memAddress + 128, 32766);
        do Memory.poke(memAddress + 160, -1);
        do Memory.poke(memAddress + 192, -1);
        do Memory.poke(memAddress + 224, -1);
        do Memory.poke(memAddress + 256, -1);
        do Memory.poke(memAddress + 288, -1);
        do Memory.poke(memAddress + 320, -1);
        do Memory.poke(memAddress + 352, 32766);
        do Memory.poke(memAddress + 384, 32766);
        do Memory.poke(memAddress + 416, 16380);
        do Memory.poke(memAddress + 448, 8184);
        do Memory.poke(memAddress + 480, 2016);

        return;
    }

    // Método para mover la pelota a 90 grados
    //method void move90() {
        //do this.erase(); // Borra la pelota en la posición actual
        //let location = location + 32; // Calcula la nueva posición
        //do this.draw(); // Dibuja la pelota en la nueva posición
        //return;
    //}
}
